PORT=8000
# Path to Ultralytics .pt (relative to ml-service/). Leave empty for stub classify.
# Example after copying Hamza weights: ./models/dental-yolo.pt  (*.pt is gitignored)
YOLO_MODEL_PATH=
YOLO_CONFIDENCE=0.25
DEVICE=cpu

# Diagnosis text: local (default) = trained YOLO + class-aligned RAG (no cloud LLM).
# Set to anthropic only if you explicitly want Claude (requires ANTHROPIC_API_KEY).
DIAGNOSIS_BACKEND=local
ANTHROPIC_API_KEY=

# Class-aligned PDFs: RAG_PDF_DIR/<class_slug>/*.pdf  (see rag/pdfs/README.md)
RAG_PDF_DIR=./rag/pdfs
