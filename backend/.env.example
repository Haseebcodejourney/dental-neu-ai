# Dental NEU AI API — copy to .env and fill in values.
# Do not commit real credentials / passwords.

NODE_ENV=development
PORT=3000

# FastAPI ML service (CV + RAG/LLM)
ML_SERVICE_URL=http://localhost:8000

# Schema sync: always on when NODE_ENV != production.
# For first boot against empty Aurora with NODE_ENV=production, set true once, then false.
# Ongoing prod schema changes should use TypeORM migrations (not yet scaffolded).
SYNC_SCHEMA=false

# --- Local Postgres (docker compose) ---
# Compose maps container 5432 → host 5433 (avoids Windows Postgres on 5432).
# DATABASE_HOST=localhost
# DATABASE_PORT=5433
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=dental_neu_ai
# DATABASE_SSL=false
# DATABASE_ENSURE=true

# --- AWS Aurora PostgreSQL (RDS) — password auth + SSL ---
# Use the cluster writer endpoint (not a reader endpoint) for CREATE DATABASE / sync.
# Example (eu-north-1):
DATABASE_HOST=database-1.cluster-chq02gsowk5h.eu-north-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-aurora-master-password
DATABASE_NAME=dental_neu_ai
DATABASE_SSL=true
# Connect to this DB first to CREATE DATABASE dental_neu_ai IF missing (requires CREATEDB).
DATABASE_MAINTENANCE_NAME=postgres
DATABASE_ENSURE=true
