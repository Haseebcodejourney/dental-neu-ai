# Dental NEU AI API — copy to .env and fill in values.
# Do not commit real credentials.

NODE_ENV=development
PORT=3000

# --- Local Postgres (docker compose) ---
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=dental_neu_ai
# DATABASE_SSL=false

# --- AWS RDS PostgreSQL ---
# Endpoint from RDS console (no scheme), e.g. mydb.xxxx.us-east-1.rds.amazonaws.com
DATABASE_HOST=your-rds-endpoint.region.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USER=dental_app
DATABASE_PASSWORD=replace-with-strong-secret
DATABASE_NAME=dental_neu_ai
# RDS requires TLS in typical setups
DATABASE_SSL=true
