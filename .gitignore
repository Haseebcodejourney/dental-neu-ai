.DS_Store
*.log
.env
.env.local
node_modules/
dist/
coverage/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# ML weights / local data (do not commit)
*.pt
*.pth
*.onnx
ml-service/models/
ml-service/runs/
ml-service/data/**
!ml-service/data/rag/
!ml-service/data/rag/.gitkeep
# Keep class-aligned RAG folder scaffold; never commit PDF corpus
!ml-service/rag/
!ml-service/rag/pdfs/
!ml-service/rag/pdfs/**
ml-service/rag/pdfs/**/*.pdf
*.pdf

# YOLO dataset payloads (keep folder structure + example yaml)
ml-service/datasets/**/data.yaml
ml-service/datasets/**/images/**/*.jpg
ml-service/datasets/**/images/**/*.jpeg
ml-service/datasets/**/images/**/*.png
ml-service/datasets/**/images/**/*.tif
ml-service/datasets/**/images/**/*.tiff
ml-service/datasets/**/images/**/*.bmp
ml-service/datasets/**/images/**/*.webp
ml-service/datasets/**/labels/**/*.txt

