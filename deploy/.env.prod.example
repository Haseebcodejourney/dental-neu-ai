# Copy to deploy/.env.prod on the VPS and fill values. NEVER commit .env.prod.

# Strong password for local Postgres on Contabo (compose postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dental_neu_ai

# Browser origins allowed by Nest CORS (comma-separated)
CORS_ORIGINS=http://13.140.160.31,http://localhost:3041

# First boot against empty DB: true. After schema is stable, prefer migrations / set false.
SYNC_SCHEMA=true

# Point Nest at the optional ml-service container (only if --profile ml is used)
ML_SERVICE_URL=http://ml-service:8000

# --- Optional ML profile ---
# YOLO_MODEL_PATH=./models/dental-yolo.pt
# ML_MODELS_HOST_PATH=/opt/dental-neu-ai/ml-service/models
# DEVICE=cpu
# DIAGNOSIS_BACKEND=local
